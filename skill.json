{
  "name": "genpark-agent-tool-call-self-healing-retry-guard-skill",
  "version": "1.0.0",
  "description": "GenPark AI Agent Skill - Deterministic AST tool-call schema auto-repair guard intercepting parameter type mismatches and eliminating expensive LLM error roundtrips.",
  "homepage": "https://genpark.ai/mcp",
  "author": "genpark",
  "category": "agent-runtime",
  "tags": [
    "autogen",
    "langgraph",
    "tool-call-repair",
